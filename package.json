{
  "name": "finchtech-my",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,css,mjs,md}\"",
    "test": "vitest run",
    "test:workflow": "node --test scripts/tests/merge-workflow.test.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "enforce:author": "sh scripts/enforce-author.sh",
    "merge:local": "sh scripts/merge-local.sh",
    "worktree:init": "sh scripts/worktree-init.sh",
    "worktree:cleanup": "sh scripts/worktree-cleanup.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.8",
    "wrangler": "^4.113.0"
  }
}
