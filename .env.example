# finchtech.my — env template
# Copy to .dev.vars for local dev (`cp .env.example .dev.vars`).
# .dev.vars is gitignored — never commit real secrets.
# Remote (Workers) secrets use `npx wrangler secret put <NAME>` or the dashboard.

# ---------------------------------------------------------------------------
# Public — baked into the client bundle at build time (safe to expose)
# ---------------------------------------------------------------------------
# Cloudflare Turnstile site key (Cloudflare dashboard → Turnstile → Add site).
# Configured in the widget by NEXT_PUBLIC_TURNSTILE_SITE_KEY (components/contact.tsx).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...

# ---------------------------------------------------------------------------
# Secrets — set via `.dev.vars` locally, `wrangler secret put` remotely
# ---------------------------------------------------------------------------
# Cloudflare Turnstile secret key (paired with the site key above).
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Telegram delivery — bot token from BotFather, chat/channel ID for notifications.
# Payload shape matches finchtech-backend Log::channel('telegram') (Name/Contact/Message).
TELEGRAM_BOT_TOKEN=1234567890:AAH...real_token_here
TELEGRAM_CHAT_ID=-1001234567890

# Email delivery — choose exactly one provider. Brevo is primary; Sender.net
# is a drop-in alternative (lib/contact.ts). Setting both is allowed — Brevo
# takes precedence. Get keys from Brevo dashboard → SMTP & API → API Keys
# (https://app.brevo.com/settings/keys/api) or Sender.net dashboard.
BREVO_API_KEY=xkeysib-...your_brevo_key
# Alternative to BREVO_API_KEY — only one is required:
# SENDER_API_KEY=...your_sender_net_key

CONTACT_FROM_EMAIL=noreply@finchtech.my
CONTACT_TO_EMAIL=support@finchtech.my

# ---------------------------------------------------------------------------
# Vars (non-secret) — also in wrangler.toml [vars]; override per-env there
# ---------------------------------------------------------------------------
ENVIRONMENT=production
