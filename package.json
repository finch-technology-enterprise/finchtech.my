{
  "name": "finchtech-my",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,css,mjs,md}\"",
    "test": "vitest run",
    "smoke": "sh scripts/smoke.sh",
    "leads": "sh scripts/leads.sh",
    "test:workflow": "node --test scripts/tests/merge-workflow.test.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "enforce:author": "sh scripts/enforce-author.sh",
    "merge:local": "sh scripts/merge-local.sh",
    "worktree:init": "sh scripts/worktree-init.sh",
    "worktree:cleanup": "sh scripts/worktree-cleanup.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
